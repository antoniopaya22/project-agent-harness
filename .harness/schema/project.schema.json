{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harness/project.schema.json",
  "title": "Harness project configuration",
  "description": "The single place a project declares how it is built, tested and organised. Read by every agent and command.",
  "type": "object",
  "additionalProperties": false,
  "required": ["harness_version", "project", "git", "gates", "areas"],
  "properties": {
    "$schema": { "type": "string" },
    "harness_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Harness version this project was generated with. Used by `harness upgrade`."
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "purpose", "output_language"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "purpose": {
          "type": "string",
          "minLength": 20,
          "description": "One paragraph: what this project is for and who uses it. Asked of the human, never invented."
        },
        "task_prefix": {
          "type": ["string", "null"],
          "pattern": "^[A-Z][A-Z0-9]{1,9}$",
          "description": "Project tag used only at the external-tracker boundary, e.g. PANGEA. Local ids stay type-prefixed."
        },
        "output_language": {
          "type": "string",
          "description": "BCP-47-ish language tag for generated deliverables (docs, tasks, agent replies). Prompts stay in English.",
          "enum": ["es", "en"]
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_branch", "auto_pr"],
      "properties": {
        "default_branch": { "type": "string", "default": "main" },
        "protected_branches": {
          "type": "array",
          "items": { "type": "string" },
          "description": "`harness` refuses to commit directly on these."
        },
        "commit_scopes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Allowed conventional-commit scopes. Empty means any scope is accepted."
        },
        "auto_pr": {
          "type": "string",
          "enum": ["ready", "draft", "never"],
          "default": "ready",
          "description": "What /commit does when a task reaches in_review. Merging is never automatic."
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "description": "The only place build/test commands are declared. Agents never guess a command.",
      "properties": {
        "format": { "$ref": "#/$defs/gate" },
        "lint": { "$ref": "#/$defs/gate" },
        "typecheck": { "$ref": "#/$defs/gate" },
        "test": { "$ref": "#/$defs/gate" },
        "build": { "$ref": "#/$defs/gate" },
        "start": { "$ref": "#/$defs/gate" }
      }
    },
    "areas": {
      "type": "array",
      "description": "Slices of the codebase. Each has exactly one doc, which is read path step 4.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "globs", "doc"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "title": { "type": "string" },
          "globs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "doc": { "type": "string" }
        }
      }
    },
    "layout": {
      "type": "string",
      "description": "Layout profile id from .harness/layouts/, or 'as-is' to forbid any code movement.",
      "default": "as-is"
    },
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "description": "Which adapter directories `harness generate` writes.",
      "properties": {
        "claude": { "type": "boolean", "default": true },
        "agents_md": { "type": "boolean", "default": true },
        "cursor": { "type": "boolean", "default": false },
        "copilot": { "type": "boolean", "default": false }
      }
    },
    "integrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clickup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "list_id": { "type": ["string", "null"] },
            "custom_fields": {
              "type": "object",
              "additionalProperties": { "type": "string" },
              "description": "Field name -> ClickUp field id."
            },
            "users": {
              "type": "object",
              "additionalProperties": { "type": ["string", "number"] },
              "description": "Harness assignee id -> ClickUp user id."
            }
          }
        }
      }
    },
    "packages": {
      "type": "array",
      "description": "Monorepo only. Each package may override gates and owns its own areas.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": { "type": "string" },
          "layout": { "type": "string" },
          "gates": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "read_path": {
      "type": "array",
      "description": "The cold-start read path, with a line budget per file. Enforced by `harness doctor`.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "max_lines"],
        "properties": {
          "path": { "type": "string" },
          "max_lines": { "type": "integer", "minimum": 1 },
          "note": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run": {
          "type": ["string", "null"],
          "description": "The command. null means there is none."
        },
        "check": {
          "type": ["string", "null"],
          "description": "Non-mutating variant, for CI (e.g. `ruff format --check .`)."
        },
        "required": {
          "type": "boolean",
          "default": false,
          "description": "A red required gate blocks /commit and blocks in_review."
        },
        "status": {
          "type": "string",
          "enum": ["configured", "not-configured", "n/a"],
          "default": "configured",
          "description": "not-configured and n/a are skipped with a warning and never block."
        },
        "coverage_min": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
      }
    }
  }
}
